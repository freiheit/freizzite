{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enablePreCommit",
  ],

  "rebaseWhen": "auto",

  "dependencyDashboardAutoclose": true,

  "packageRules": [
    {
      // config:best-practices pulls in abandonments:recommended, which flags
      // any dep with no release in 1 year as abandoned. Base images and
      // GitHub Actions here move on their own cadence; 1 year is far too
      // eager and just fills the dependency dashboard with noise.
      "abandonmentThreshold": "5 years",
      "matchPackageNames": ["*"],
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      // Merges once required checks pass; majors and third-party actions (which
      // run with signing/registry secrets) still wait for a human.
      "automerge": true,
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/**", "github/**", "docker/**", "sigstore/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
    },
    // This prevents the default demo image used in ublue-os/image-template
    // from being pinned as it serves no purpose there
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/bazzite"],
      "pinDigests": false
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    {
      // The build gate resolves and pins the base image digest at build time,
      // so the Containerfile's ARG BASE_TAG digest is only ever a local-dev
      // default -- CI overrides it per matrix target. Renovate bumping it just
      // opens a PR on every upstream move, duplicating what the gate does.
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest"],
      "matchFileNames": ["Containerfile"],
    },
  ]
}
