#!/bin/bash
# Freizzite: cosmetic rebranding of os-release, after upstream bazzite's
# build_files/image-info. ID, ID_LIKE, VARIANT_ID, CPE_NAME, IMAGE_ID and
# image-info.json keep their upstream values so anything keying off them still
# works. Runs last in build.sh: /usr/lib/os-release is rpm-owned.

set -ouex pipefail

IMAGE_PRETTY_NAME="Freizzite"
UPSTREAM_PRETTY_NAME="Bazzite"
HOME_URL="https://github.com/freiheit/freizzite"
BUG_SUPPORT_URL="https://github.com/freiheit/freizzite/issues"

# assign separately: a failed substitution inside `echo` would not trip set -e
FEDORA_VERSION=$(rpm -E %fedora)

# OS Release File. DOCUMENTATION_URL and SUPPORT_URL stay upstream.
sed -i "s|^NAME=.*|NAME=\"$IMAGE_PRETTY_NAME\"|" /usr/lib/os-release
# Substituted, not overwritten, to keep any suffix upstream appends
sed -i "s|^PRETTY_NAME=\"$UPSTREAM_PRETTY_NAME|PRETTY_NAME=\"$IMAGE_PRETTY_NAME|" /usr/lib/os-release
sed -i "s|^BOOTLOADER_NAME=\"$UPSTREAM_PRETTY_NAME|BOOTLOADER_NAME=\"$IMAGE_PRETTY_NAME|" /usr/lib/os-release
sed -i "s|^VARIANT=.*|VARIANT=\"$IMAGE_PRETTY_NAME (based on $UPSTREAM_PRETTY_NAME)\"|" /usr/lib/os-release
sed -i "s|^DEFAULT_HOSTNAME=.*|DEFAULT_HOSTNAME=\"${IMAGE_PRETTY_NAME,}\"|" /usr/lib/os-release
sed -i "s|^HOME_URL=.*|HOME_URL=\"$HOME_URL\"|" /usr/lib/os-release
sed -i "s|^BUG_REPORT_URL=.*|BUG_REPORT_URL=\"$BUG_SUPPORT_URL\"|" /usr/lib/os-release
sed -i "s|^LOGO=.*|LOGO=${IMAGE_PRETTY_NAME,}-logo-icon|" /usr/lib/os-release

# grub2-mkconfig takes its distributor from here
echo "$IMAGE_PRETTY_NAME release $FEDORA_VERSION" >/etc/system-release

# A new icon is invisible to GTK when the theme's cache does not list it
gtk-update-icon-cache -f /usr/share/icons/hicolor

# sed exits 0 when it matches nothing
grep -q "^PRETTY_NAME=\"$IMAGE_PRETTY_NAME" /usr/lib/os-release
# our profile.d copy hardcodes this; catch bazzite moving it
test -f /usr/share/ublue-os/bazzite/fastfetch.jsonc

cat /usr/lib/os-release /etc/system-release
